#!name=YouTube tvOS 内部路径采集调试版 v9 MITM+JSC
#!desc=显式开启 Shadowrocket 自身 HTTPS 解密与 HTTP/2 MITM；tvOS 强制使用 JavaScriptCore；仅向局域网 Mac 上报脱敏 host/path
#!author=Maasea / local privacy-minimized tvOS diagnostics
#!homepage=https://github.com/scutjiuyi-oss/shadowrocket-youtube-module

[Rule]
# 局域网采集端始终直连，不经过 VPS 或公网代理
IP-CIDR,192.168.1.130/32,DIRECT,no-resolve

# 禁止 QUIC，使 Shadowrocket 自身 HTTPS 解密和脚本可以看到 TCP 流量
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,youtube.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,googleapis.com),(PROTOCOL,UDP)),REJECT

# 已确认的静态广告域名
DOMAIN,ads.youtube.com,REJECT
DOMAIN-SUFFIX,doubleclick.net,REJECT
DOMAIN,www.googleadservices.com,REJECT
DOMAIN,pagead2.googlesyndication.com,REJECT
DOMAIN,ade.googlesyndication.com,REJECT
DOMAIN,tpc.googlesyndication.com,REJECT

[URL Rewrite]
^https?:\/\/(www|s)\.youtube\.com\/api\/stats\/ads - reject-200
^https?:\/\/(www|s)\.youtube\.com\/(pagead|ptracking) - reject-200
^https?:\/\/s\.youtube\.com\/api\/stats\/qoe\?adcontext - reject-200

[Script]
# tvOS 不依赖默认 WebView：显式使用 JavaScriptCore。
# 隐私最小化路径采集：不读取查询参数、Cookie、Authorization 或正文。
youtube.path.request.v9 = type=http-request,engine=jsc,pattern=^https:\/\/(?:youtubei\.googleapis\.com|youtube\.googleapis\.com|(?:www|s|music)\.youtube\.com|[\w-]+\.googlevideo\.com)\/.*,requires-body=0,script-path=https://raw.githubusercontent.com/scutjiuyi-oss/shadowrocket-youtube-module/79a3b4e08acd9e647e6b1bd107dbb74a6479bb7b/youtube-tvos-path-lan-report.js
youtube.path.response.v9 = type=http-response,engine=jsc,pattern=^https:\/\/(?:youtubei\.googleapis\.com|youtube\.googleapis\.com|(?:www|s|music)\.youtube\.com|[\w-]+\.googlevideo\.com)\/.*,requires-body=0,script-path=https://raw.githubusercontent.com/scutjiuyi-oss/shadowrocket-youtube-module/79a3b4e08acd9e647e6b1bd107dbb74a6479bb7b/youtube-tvos-path-lan-report.js

# Maasea Protobuf 响应清洗，固定到已审计 commit，并显式使用 JSC。
youtube.response.youtubei = type=http-response,engine=jsc,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config)(\?.*)?$,requires-body=1,max-size=4194304,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Maasea/sgmodule/65075cdb388fc5e3094afd7e7314c67b243f3525/Script/Youtube/youtube.response.js,argument="{"captionLang":"off","blockUpload":true,"blockImmersive":true,"blockShorts":false,"debug":true}"
youtube.response.www = type=http-response,engine=jsc,pattern=^https:\/\/www\.youtube\.com\/youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config)(\?.*)?$,requires-body=1,max-size=4194304,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Maasea/sgmodule/65075cdb388fc5e3094afd7e7314c67b243f3525/Script/Youtube/youtube.response.js,argument="{"captionLang":"off","blockUpload":true,"blockImmersive":true,"blockShorts":false,"debug":true}"
youtube.request.init = type=http-request,engine=jsc,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*,requires-body=1,max-size=4194304,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Maasea/sgmodule/65075cdb388fc5e3094afd7e7314c67b243f3525/Script/Youtube/youtube.request.js,argument="{"captionLang":"off","debug":true}"

[MITM]
# 使用 Shadowrocket 自身已生成/已信任的证书；不嵌入任何外部 CA 或私钥。
enable = true
h2 = true
hostname = %APPEND% *.googlevideo.com,www.youtube.com,s.youtube.com,music.youtube.com,youtubei.googleapis.com,youtube.googleapis.com
