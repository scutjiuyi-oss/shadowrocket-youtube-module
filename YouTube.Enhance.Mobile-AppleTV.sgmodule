#!name=YouTube 去广告增强版（手机 + Apple TV）
#!desc=最小化 HTTPS 解密：仅清洗 youtubei.googleapis.com，兼容使用该 API 的 iPhone/iPad/Apple TV
#!author=scutjiuyi-oss / Maasea engine snapshot
#!homepage=https://github.com/scutjiuyi-oss/shadowrocket-youtube-module

[Rule]
# 阻断 YouTube QUIC，使请求回退到可进行 HTTPS 解密的 TCP
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT

# 静态广告与追踪域名
DOMAIN,ad.doubleclick.net,REJECT
DOMAIN,ads.youtube.com,REJECT
DOMAIN-SUFFIX,doubleclick.net,REJECT

[Script]
# iPhone / iPad / Apple TV 共用的 Innertube Protobuf 响应
youtube_response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config)(\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/scutjiuyi-oss/shadowrocket-youtube-module/main/youtube.response.js,argument="{"captionLang":"off","blockUpload":false,"blockImmersive":false,"blockShorts":false,"debug":false}"

[MITM]
hostname = %APPEND% youtubei.googleapis.com
